# Copy to .env for local work (export the variables yourself or use: node --env-file=.env server.js)
PORT=8080
NODE_ENV=development
# MongoDB Atlas connection string. Leave empty in development to use an in-memory database.
MONGODB_URI=
MONGODB_DB=queenstown
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Created on first start only, when no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Comma separated list of website addresses allowed to call the API (no trailing slash).
CLIENT_ORIGINS=http://localhost:3000
# Razorpay (Dashboard > Account & Settings > API keys). Leave empty to keep online payment off.
# Use rzp_test_ keys first. The webhook secret is the one you type when you create the webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
